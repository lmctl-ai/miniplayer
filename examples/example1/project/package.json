{
  "name": "notes",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny TypeScript CLI note taker backed by plain .txt files",
  "type": "module",
  "bin": {
    "notes": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/notes.test.ts test/cli.test.ts",
    "test:dist": "npm run build && node --test dist/test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
