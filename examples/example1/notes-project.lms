// access: write (creates a project directory and runs the build/test commands the model proposes there)
// What it does: builds a small TypeScript note-taking CLI end to end with miniplayer as the "brain"
//   and this script as the deterministic hands. Every miniplayer call is a stateless one-shot:
//   prompt in, text out. No tool calling, no session; the script re-sends whatever context each call needs.
//   1. ask miniplayer for a design document      2. ask a second, fresh miniplayer call to implement it
//   3. the script writes the files, runs build_command / test_command from the reply's last paragraph
//   4. on failure the error output goes back to miniplayer to fix; loop; stop when build and tests pass
// How to run: lmscript notes-project.lms <model> [project-dir] [max-fix-rounds]
//   miniplayer runs as a managed lmctl provider (lm_agent), so `lmctl ls` and `lmctl cost` see every call.
//   No timeouts are set here: lmctl's own limits apply.
// Safety: the build/test commands are written by a model. They run as argv (split_command, shell:false)
//   inside the project directory; shell syntax in them is refused. Point it at a scratch directory.

if (len(ARGV) < 1) {
  println("usage: lmscript notes-project.lms <model> [project-dir] [max-fix-rounds]");
  exit(1);
}
MODEL = ARGV[0];
DIR = len(ARGV) > 1 ? ARGV[1] : "/tmp/notes-project";
MAX_ROUNDS = len(ARGV) > 2 ? num(ARGV[2]) : 5;
WORK = path_join(DIR, ".mp");

FORMAT_RULES = "Output format for source files: for every file write a line `=== FILE: relative/path ===` followed by the complete file content, and finish each file with a line `=== END ===`. Use relative paths only. Do not add markdown fences around file content. Always send complete files, never diffs or fragments.";
TAIL_RULES = """The LAST paragraph of your reply must contain exactly these two lines and nothing else, each on its own line:
build_command: <one command that compiles/type-checks the project; no shell operators>
test_command: <one command that runs the tests and exits non-zero on failure; no shell operators>""";

// One stateless miniplayer call (a fresh member map each time: no session); prompt and answer are kept in .mp.
fn ask(name, prompt) {
  r = lm_agent({provider: "miniplayer", model: MODEL}, prompt);
  if (r.status != "ok") {
    println("miniplayer failed (" + name + "):", r.error);
    exit(1);
  }
  write_files(WORK, [{path: name + ".prompt.txt", content: prompt}, {path: name + ".answer.txt", content: r.reply}]);
  return r.reply;
}

// Write the reply's file blocks; returns the reply's build/test commands (missing keys stay absent).
fn apply(reply) {
  res = write_files(DIR, parse_file_blocks(reply));
  println("wrote", len(res.written), "files");
  for (bad in res.rejected) {
    println("rejected", bad.path + ":", bad.reason);
  }
  return kv_from_last_paragraph(reply);
}

fn run(command, limit) {
  r = system(split_command(command), {cwd: DIR});
  return r.code == 0 ? null : f"""FAILED (exit {r.code})
command: {command}
{join(slice(lines(r.stdout + r.stderr), -limit), "\n")}""";
}

// ---- 1. design -------------------------------------------------------------------------------
println("[1/3] design document");
design = ask("design", """Write a concise design document in markdown (no code, under 120 lines) for this project.

REQUIREMENTS
Create a TypeScript project: a command line note taker. Notes are plain .txt files stored in a single directory (default ./notes, overridable with NOTES_DIR). Commands: `create <name> [text]` (text from the argument or stdin), `list`, `show <name>`, `overwrite <name> [text]` (replace an existing note; error if missing), `delete <name>`. Note names are validated (letters, digits, dash, underscore only) so a name can never escape the directory. Exit code 0 on success, non-zero with a message on stderr on failure. Use only Node built-ins at runtime; tests use node:test through tsx or compiled output. State the file layout, module split, error behaviour, the test plan, and the exact build and test commands.""");
write_files(DIR, [{path: "DESIGN.md", content: design}]);

// ---- 2. implement ----------------------------------------------------------------------------
println("[2/3] implementation");
cfg = apply(ask("implement", f"""You are a fresh engineer. Implement this project exactly as the design document says.

{FORMAT_RULES}
Include package.json (with a `build` and a `test` script and devDependencies if needed), tsconfig.json, the source, and the tests.
{TAIL_RULES}

DESIGN DOCUMENT
{design}"""));
if (!has_key(cfg, "build_command") || !has_key(cfg, "test_command")) {
  println("implementation reply was unusable (no build_command/test_command); see", path_join(WORK, "implement.answer.txt"));
  exit(1);
}

// ---- 3-4. build / test / fix loop ------------------------------------------------------------
println("[3/3] build and test loop (max", MAX_ROUNDS, "fix rounds)");
round = 0;
failure = "first";
while (failure != null) {
  println("-- round", round, "| build:", cfg.build_command, "| test:", cfg.test_command);
  if (file_exists(path_join(DIR, "package.json"))) {
    system(["npm", "install", "--no-audit", "--no-fund"], {cwd: DIR});
  }
  failure = run(cfg.build_command, 60);
  if (failure == null) {
    failure = run(cfg.test_command, 80);
  }
  if (failure != null && round >= MAX_ROUNDS) {
    println("giving up after", round, "fix rounds");
    println(failure);
    exit(2);
  }
  if (failure != null) {
    round = round + 1;
    println(f"fix round {round}");
    next = apply(ask(f"fix{round}", f"""A project you wrote fails. Fix it.

DESIGN DOCUMENT
{design}

CURRENT FILES
{format_file_blocks(read_tree(DIR))}

FAILURE
{failure}

Send ONLY the files you change, in full. {FORMAT_RULES}
{TAIL_RULES}"""));
    cfg = merge(cfg, next);
  }
}
println("build and tests pass after", round, "fix rounds");
println("done:", DIR);
